{
  "type": "record",
  "name": "PayrollEmployee",
  "namespace": "com.flinkpipeline.payroll.avro",
  "fields": [
    { "name": "employee_id", "type": "int" },
    { "name": "first_name", "type": "string" },
    { "name": "last_name", "type": "string" },
    { "name": "age", "type": ["null", "int"], "default": null },
    { "name": "ssn", "type": ["null", "string"], "default": null },
    { "name": "hourly_rate_cents", "type": ["null", "int"], "default": null },
    { "name": "gender", "type": ["null", "string"], "default": null },
    { "name": "email", "type": ["null", "string"], "default": null },
    { "name": "source_system", "type": ["null", "string"], "default": null },
    { "name": "ingestion_timestamp", "type": ["null", "long"], "default": null },
    { "name": "pipeline_version", "type": ["null", "string"], "default": null }
  ]
}
